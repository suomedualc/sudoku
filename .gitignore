# Gradle
.gradle/
build/
# IDE / 编译器自己的产物目录（与 build/ 同类，可随时删除）
composeApp/bin/

# 本机大体积工作资料（74MB 对话导出等，不入库）
docs/*.json

# Kotlin
.kotlin/

# 本机环境（含 SDK 路径，不入库）
local.properties

# IDE
.idea/
*.iml
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 本机快捷方式（指向 build/ 下的便携版，路径随机器而变，不入库）
*.lnk

# 旧版工程
/target

# archive/ 只保留源码与 zip：依赖与前端构建产物不入库
archive/**/node_modules/
archive/**/dist/

# 归档不公开
archive/
